<generatorConfiguration>
  <context id="default" targetRuntime="MyBatis3">

    <plugin type="org.mybatis.generator.plugins.EqualsHashCodePlugin"></plugin>
    <plugin type="org.mybatis.generator.plugins.FluentBuilderMethodsPlugin"></plugin>
    <plugin type="org.mybatis.generator.plugins.ToStringPlugin"></plugin>
    <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin"></plugin>
    <plugin type="org.mybatis.generator.plugins.RowBoundsPlugin"></plugin>
    <!-- <plugin type="org.mybatis.generator.plugins.SerializablePlugin"></plugin> -->
    <plugin type="org.mybatis.generator.plugins.VirtualPrimaryKeyPlugin"></plugin>

    <plugin type="com.lbisoft.mybatis.generator.plugins.ConcurrencyPlugin">
      <property name="changeDateField" value="SYSTEM_LAST_CHANGE_DATE" />
      <property name="fetchDateName" value="fetchDate" />
      <property name="dbName" value="ranpaktrak2" />
    </plugin>
    <plugin type="com.lbisoft.mybatis.generator.plugins.UpdateModifiedPlugin"></plugin>
    <plugin type="com.lbisoft.mybatis.generator.plugins.RootInterfacePlugin">
      <property name="modelInterface" value="com.lbisoft.core.framework.dao.db.DbModel" />
      <property name="mapperInterface" value="com.lbisoft.core.framework.dao.db.DbMapper" />
      <property name="mapperInterfaceWithoutPrimaryKey"
        value="com.lbisoft.core.framework.dao.db.DbMapperWithoutPrimaryKey" />
      <property name="exampleInterface" value="com.lbisoft.core.framework.dao.db.DbExample" />
    </plugin>
    <plugin type="com.lbisoft.mybatis.generator.plugins.AddCreateExamplePlugin"></plugin>
    <plugin type="com.lbisoft.mybatis.generator.plugins.NoAuditFieldsPlugin"></plugin>


    <commentGenerator>
      <property name="suppressDate" value="true" />
    </commentGenerator>

    <jdbcConnection driverClass="com.microsoft.sqlserver.jdbc.SQLServerDriver" connectionURL="@database.url@"
      userId="@database.username@" password="@database.password@"></jdbcConnection>

    <javaTypeResolver>
      <property name="forceBigDecimals" value="false" />
      <property name="useJSR310Types" value="true" />
    </javaTypeResolver>

    <javaModelGenerator targetPackage="com.lbisoft.core.app.db.model.generated"
      targetProject="src/main/java">
      <property name="enableSubPackages" value="false" />
    </javaModelGenerator>

    <sqlMapGenerator targetPackage="com.lbisoft.core.app.db.mapper.generated"
      targetProject="src/main/resources">
      <property name="enableSubPackages" value="false" />
    </sqlMapGenerator>

    <javaClientGenerator type="XMLMAPPER" targetPackage="com.lbisoft.core.app.db.mapper.generated"
      targetProject="src/main/java">
      <property name="enableSubPackages" value="false" />
    </javaClientGenerator>

